{
  "WorkingDirectory": "src",
  "Docker": {
    "ComposePath": "docker-compose.yml",
    "BuildArguments": "compose -f docker-compose.yml -f ../prod/docker-compose.publish.yml build",
    "PushArguments": "compose -f docker-compose.yml -f ../prod/docker-compose.publish.yml push",
    "ImageTagSettings": {
      "TagReplacementComposeFilePath": "../prod/docker-compose.yml"
    },
    "EnvironmentVariables": {
      "DOCKER_REGISTRY": "localhost:5000/"
    },
    "Services": [
      {
        "Name": "mysql",
        "Ignore": true
      },
      {
        "Name": "rabbitmq",
        "Ignore": true
      },
      {
        "Name": "prometheus",
        "Ignore": true
      },
      {
        "Name": "loki",
        "Ignore": true
      },
      {
        "Name": "otelcollector",
        "Ignore": true
      },
      {
        "Name": "grafana",
        "Ignore": true
      }
    ]
  }
}
